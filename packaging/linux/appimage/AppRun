#!/bin/sh
# AppImage entry point for AI Upscaler Studio.
# The AppImage is mounted read-only; the application writes models, logs and
# configuration only to XDG user directories (~/.cache, ~/.local/state, ...).
HERE="$(dirname "$(readlink -f "$0")")"
exec "$HERE/usr/lib/ai-upscaler-studio/ai-upscaler-studio" "$@"
